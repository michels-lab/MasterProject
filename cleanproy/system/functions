FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      functions;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *

    temperatureProbe
    {
        // Mandatory entries
        type            probes;
        libs            ("libfieldFunctionObjects.so");
        region          metal;

        fields          (T);

        probeLocations
        (
            (0.02 0.02 0.005)
        );

        // Optional entries
        executeControl  timeStep;
        executeInterval 1;
        writeControl    timeStep;
        writeInterval   1;
        writeToFile     true;    
    }



