# ============================================================
# OpenFOAM / Thesis repository
# Keep source and configuration files.
# Ignore generated results, media, archives and build files.
# ============================================================


# ============================================================
# OpenFOAM calculated time directories
# ============================================================

# Ignore calculated times: 0.001, 0.1, 1, 2, 5, 10, etc.
**/[0-9]*/

# Always keep initial-condition directory 0/
!**/0/


# ============================================================
# OpenFOAM / simulation logs
# ============================================================

# Simulation/runtime logs are intentionally tracked as part of the
# numerical record. This includes log.foamMultiRun and the parsed
# logs/ directories generated by foamLog. Do not add broad log.*,
# *.log, or **/logs/ ignore rules here.


# ============================================================
# OpenFOAM post-processing / scientific results
# ============================================================

# postProcessing/ is intentionally TRACKED.
# Residual summaries, probes, sampled velocity/temperature/phase profiles,
# integrals, extrema and other derived diagnostics are part of the scientific
# record and must remain available for reproducible analysis.
#
# The explicit negations below also override the generic numeric-directory
# rule above for postProcessing time folders such as 0.1/, 4.8/ and 10/.
!**/postProcessing/
!**/postProcessing/**

# Curated scientific exports/results are also always tracked. Use these
# directories when a derived field, table, profile, comparison or diagnostic
# is selected as thesis evidence but does not naturally live in postProcessing/.
!**/analysis_results/
!**/analysis_results/**
!**/scientific_results/
!**/scientific_results/**


# ============================================================
# Parallel decomposition
# ============================================================

**/processor*/
**/processors*/


# ============================================================
# Generated meshes
# ============================================================

**/constant/polyMesh/
**/constant/*/polyMesh/


# ============================================================
# Generated OpenFOAM helper fields
# ============================================================

**/cellToRegion


# ============================================================
# OpenFOAM dynamic compilation
# ============================================================

**/dynamicCode/
**/platforms/
**/*.o
**/*.dep
**/*.so


# ============================================================
# ParaView generated files
# ============================================================

**/*.foam
**/*.OpenFOAM

# Images
**/*.png
**/*.PNG
**/*.jpg
**/*.JPG
**/*.jpeg
**/*.JPEG

# Videos
**/*.mp4
**/*.MP4
**/*.mov
**/*.MOV
**/*.avi
**/*.AVI
**/*.mkv
**/*.MKV
**/*.webm
**/*.WEBM

# VTK exports
**/VTK/
**/*.vtk
**/*.vtu
**/*.vtp
**/*.pvtu


# ============================================================
# Compressed archives
# ============================================================

**/*.zip
**/*.ZIP
**/*.rar
**/*.RAR
**/*.7z
**/*.7Z


# ============================================================
# Runtime / crash files
# ============================================================

**/core
**/core.*


# ============================================================
# Windows metadata
# ============================================================

**/*:Zone.Identifier


# ============================================================
# Python / Jupyter generated files
# ============================================================

**/__pycache__/
**/*.pyc
**/.ipynb_checkpoints/


# ============================================================
# Editor / operating-system temporary files
# ============================================================

**/*~
**/*.swp
**/*.swo
**/.DS_Store
**/Thumbs.db


# ============================================================
# VS Code temporary files
# ============================================================

**/.vscode/*.log
