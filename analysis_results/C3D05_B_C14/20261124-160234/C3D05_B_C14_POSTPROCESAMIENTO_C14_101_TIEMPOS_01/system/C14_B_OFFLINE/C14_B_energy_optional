metalTopEnergyPower
{
    type            surfaceFieldValue;
    libs            ("libfieldFunctionObjects.so");
    region          metal;

    log             true;
    executeControl  writeTime;
    executeInterval 1;
    writeControl    writeTime;
    writeInterval   1;

    writeFields     false;
    surfaceFormat   none;
    patch           metalTop;
    operation       sum;

    fields
    (
        energyAdvectiveFlux
        heatFlux
        energyFlux
    );
}

