FoamFile
{
    version 2.0;
    format ascii;
    class dictionary;
    object C14_B_energy_optional;
}

energyAdvectiveFlux
{
    type            energyAdvectiveFlux;
    libs            ("libfieldFunctionObjects.so");
    region          metal;

    executeControl  writeTime;
    executeInterval 1;
    writeControl    writeTime;
    writeInterval   1;
}

