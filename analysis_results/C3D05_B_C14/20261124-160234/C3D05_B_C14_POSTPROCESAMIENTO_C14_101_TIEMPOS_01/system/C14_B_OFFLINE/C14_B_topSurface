FoamFile
{
    version 2.0;
    format ascii;
    class dictionary;
    object C14_B_topSurface;
}

topPatchFaceFields
{
    type            surfaceFieldValue;
    libs            ("libfieldFunctionObjects.so");
    region          metal;

    log             true;
    writeControl    timeStep;
    writeInterval   1;

    patch           metalTop;
    operation       none;

    writeFields     true;
    surfaceFormat   raw;

    fields
    (
        phi
        U
        T
        p_rgh
        rho
    );
}

