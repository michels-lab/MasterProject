FoamFile
{
    version 2.0;
    format ascii;
    class dictionary;
    object C14_B_velocity;
}

vorticityField
{
    type            vorticity;
    libs            ("libfieldFunctionObjects.so");
    region          metal;

    executeControl  writeTime;
    executeInterval 1;
    writeControl    writeTime;
    writeInterval   1;
}

flowTopology
{
    type            flowType;
    libs            ("libfieldFunctionObjects.so");
    region          metal;

    // Keep a stable canonical field name for sampling/PostPlotter.
    result          flowType;

    executeControl  writeTime;
    executeInterval 1;
    writeControl    writeTime;
    writeInterval   1;
}
