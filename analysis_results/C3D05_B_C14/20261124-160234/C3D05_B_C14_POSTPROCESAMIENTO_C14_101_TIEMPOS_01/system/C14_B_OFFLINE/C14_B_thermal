FoamFile
{
    version 2.0;
    format ascii;
    class dictionary;
    object C14_B_thermal;
}

temperatureGradient
{
    type            grad;
    libs            ("libfieldFunctionObjects.so");
    region          metal;

    field           T;
    result          gradT;

    executeControl  writeTime;
    writeControl    writeTime;
}

temperatureGradientMagnitude
{
    type            mag;
    libs            ("libfieldFunctionObjects.so");
    region          metal;

    field           gradT;
    result          magGradT;

    executeControl  writeTime;
    writeControl    writeTime;
}
