temperatureProbeB3D
{
 type probes;
 libs ("libfieldFunctionObjects.so");
 region metal;
 fields (U T p_rgh phaseChangeSource:alpha1 vorticity flowType gradT magGradT);
 probeLocations ((0.0259 -0.02 0.0259));
 executeControl timeStep;
 executeInterval 1;
 writeControl timeStep;
 writeInterval 1;
 writeToFile true;
}

