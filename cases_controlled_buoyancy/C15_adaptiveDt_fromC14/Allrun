#!/bin/sh
cd ${0%/*} || exit 1    # Run from this directory

# Source tutorial run functions
. $WM_PROJECT_DIR/bin/tools/RunFunctions

runApplication blockMesh
##runApplication createZones
runApplication splitMeshRegions -cellZones all
##splitMeshRegions -cellZones 'metal mold'

runApplication foamMultiRun
foamMultiRunStatus=$?

# Reduce the volumetric solidificationMelting momentum diagnostics to
# Git-trackable postProcessing tables and line profiles.
# Run only when foamMultiRun itself returned success.
if [ "$foamMultiRunStatus" -eq 0 ]
then
    runApplication foamPostProcess \
        -region metal \
        -dict system/momentumPostProcessing \
        -time '0:' \
        -fields '(phaseChangeSolidFraction phaseChangeDarcyCoeff phaseChangeModelDeltaT phaseChangeDarcyAcceleration phaseChangeBuoyancyAcceleration pRghAcceleration magPhaseChangeDarcyAcceleration magPhaseChangeBuoyancyAcceleration magPRghAcceleration phaseChangeDragToBuoyancy phaseChangeDragToPressure)'
else
    echo "Skipping momentum post-processing: foamMultiRun returned status $foamMultiRunStatus."
fi


# Standard derived solver diagnostics for post-processing.
# foamLog parses log.foamMultiRun into the case-level logs/ directory
# (Courant number, residuals, continuity, iterations, execution time, etc.).
rm -rf logs
rm -f log.foamLog
runApplication foamLog log.foamMultiRun

touch buoyant.foam


# Spatial metalTop post-processing for FoamLens / boundary-flow audit.
# Diagnostic only: does not alter the solved physics. Runs only after a
# successful foamMultiRun and writes face-wise/top-near fields under
# postProcessing/ plus log.topSurfaceFlowPostProcess.
if [ "$foamMultiRunStatus" -eq 0 ]
then
    repoRoot="$(cd ../.. && pwd)"

    foamPostProcess \
        -region metal \
        -dict "$repoRoot/analysis_tools/topSurfaceFlowPostProcessing" \
        -time '0:' \
        -fields '(U T p_rgh rho phi phaseChangeSource:alpha1)' \
        > log.topSurfaceFlowPostProcess 2>&1
    topSurfaceFlowStatus=$?

    if [ "$topSurfaceFlowStatus" -ne 0 ]
    then
        echo "ERROR: top-surface post-processing failed with status $topSurfaceFlowStatus."
        echo "See: $(pwd)/log.topSurfaceFlowPostProcess"
        exit "$topSurfaceFlowStatus"
    fi
else
    echo "Skipping top-surface post-processing: foamMultiRun returned status $foamMultiRunStatus."
fi

