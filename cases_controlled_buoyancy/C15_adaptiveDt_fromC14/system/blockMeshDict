FoamFile
{
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

convertToMeters 0.001;

vertices
(
    // slice on z = 0
    ( 0   0   0)         //  0
    (40   0   0)         //  1
    (40  40   0)         //  2
    ( 0  40   0)         //  3
    (-7  40   0)         //  4
    (-7   0   0)         //  5
    (-7 -15   0)         //  6
    ( 0 -15   0)         //  7
    (40 -15   0)         //  8
    (47 -15   0)         //  9
    (47   0   0)         // 10
    (47  40   0)         // 11
    // slice on z = 10 mm
    ( 0   0  10)         // 12
    (40   0  10)         // 13
    (40  40  10)         // 14
    ( 0  40  10)         // 15
    (-7  40  10)         // 16
    (-7   0  10)         // 17
    (-7 -15  10)         // 18
    ( 0 -15  10)         // 19
    (40 -15  10)         // 20
    (47 -15  10)         // 21
    (47   0  10)         // 22
    (47  40  10)         // 23
);

blocks
(
    // Baseline mesh discretization (comment/uncomment the code block below)
    /*
    hex (0  1  2 3 12 13 14 15) metal (40 40 1) simpleGrading (1 1 1)

    hex (5  0  3 4 17 12 15 16) mold  ( 7 40 1) simpleGrading (1 1 1)
    hex (6  7  0 5 18 19 12 17) mold  ( 7 15 1) simpleGrading (1 1 1)
    hex (7  8  1 0 19 20 13 12) mold  (40 15 1) simpleGrading (1 1 1)
    hex (8  9 10 1 20 21 22 13) mold  ( 7 15 1) simpleGrading (1 1 1)
    hex (1 10 11 2 13 22 23 14) mold  ( 7 40 1) simpleGrading (1 1 1)
    */

    // Finer mesh discretization (comment/uncomment the code block below)

    hex (0  1  2 3 12 13 14 15) metal (80 80 1) simpleGrading (1 1 1)

    hex (5  0  3 4 17 12 15 16) mold  (14 80 1) simpleGrading (1 1 1)
    hex (6  7  0 5 18 19 12 17) mold  (14 30 1) simpleGrading (1 1 1)
    hex (7  8  1 0 19 20 13 12) mold  (80 30 1) simpleGrading (1 1 1)
    hex (8  9 10 1 20 21 22 13) mold  (14 30 1) simpleGrading (1 1 1)
    hex (1 10 11 2 13 22 23 14) mold  (14 80 1) simpleGrading (1 1 1)

);

defaultPatch
{
    name    frontAndBack;
    type    empty;
}

boundary
(
    moldBottom
    {
        type wall;
        faces
        (
            (6 7 19 18)
            (7 8 20 19)
            (8 9 21 20)
        );
    }

    moldTop
    {
        type wall;
        faces
        (
            ( 3 4 16 15)
            (11 2 14 23)
        );
    }

    moldLeft
    {
        type wall;
        faces
        (
            (4 5 17 16)
            (5 6 18 17)
        );
    }

    moldRight
    {
        type wall;
        faces
        (
            (10 11 23 22)
            ( 9 10 22 21)
        );
    }

    metalTop
    {
        type wall;
        faces
        (
            (2 3 15 14)
        );
    }
    
);

