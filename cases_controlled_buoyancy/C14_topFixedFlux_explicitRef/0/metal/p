FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform 1e5;

boundaryField
{
    frontAndBack
    {
        type            empty;
    }

    metalTop
    {
        type            calculated;
        value           $internalField;
    }
    metal_to_mold
    {
        type            calculated;
        value           $internalField;
    }
}


