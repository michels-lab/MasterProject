FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      momentumPostProcessing;
}

// Compact, Git-trackable summaries reconstructed from the volumetric
// solidificationMelting momentum diagnostic fields after a run.
//
// The full time-directory fields remain local. foamPostProcess reads them
// from disk and writes these reduced outputs under postProcessing/.

momentumMean
{
    type            volFieldValue;
    libs            ("libfieldFunctionObjects.so");
    region          metal;

    log             true;
    writeControl    timeStep;
    writeInterval   1;
    writeFields     false;
    writeNumberOfCells true;
    writeVolume     true;

    cellZone        all;
    operation       volAverage;

    fields
    (
        phaseChangeSolidFraction
        phaseChangeDarcyCoeff
        phaseChangeModelDeltaT
        magPhaseChangeDarcyAcceleration
        magPhaseChangeBuoyancyAcceleration
        magPRghAcceleration
    );
}

