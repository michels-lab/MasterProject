momentumHorizontalProfiles
{
    type            sets;
    libs            ("libsampling.so");
    region          metal;

    writeControl    timeStep;
    writeInterval   1;

    interpolationScheme cellPoint;
    setFormat       raw;

    fields
    (
        phaseChangeSolidFraction
        phaseChangeDarcyCoeff
        phaseChangeModelDeltaT

        phaseChangeDarcyAcceleration
        phaseChangeBuoyancyAcceleration
        pRghAcceleration

        magPhaseChangeDarcyAcceleration
        magPhaseChangeBuoyancyAcceleration
        magPRghAcceleration

        phaseChangeDragToBuoyancy
        phaseChangeDragToPressure
    );

    sets
    {
        line_y10mm
        {
            type        lineUniform;
            axis        x;
            start       (0.00025 0.010 0.005);
            end         (0.03975 0.010 0.005);
            nPoints     80;
        }

        line_y20mm
        {
            type        lineUniform;
            axis        x;
            start       (0.00025 0.020 0.005);
            end         (0.03975 0.020 0.005);
            nPoints     80;
        }

        line_y30mm
        {
            type        lineUniform;
            axis        x;
            start       (0.00025 0.030 0.005);
            end         (0.03975 0.030 0.005);
            nPoints     80;
        }
    }
}

