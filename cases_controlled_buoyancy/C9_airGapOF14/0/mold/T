FoamFile
{
    format      ascii;
    class       volScalarField;
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 1 0 0 0];

internalField   uniform 300;

moldAir
{
        type            externalWallHeatFluxTemperature;
        mode            coefficient;
        h               uniform 10;
        Ta              constant 300;
        kappaMethod     solidThermo;
        emissivity      0.5;
        value           $internalField;    
}

boundaryField
{
    frontAndBack
    {
        type            empty;
    }

    moldTop
    {
        $moldAir;
    }

    moldBottom
    {
        $moldAir;
    }

    moldLeft
    {
        $moldAir;
    }

    moldRight
    {
        $moldAir;
    }

    mold_to_metal
    {
        type            coupledTemperature;
                value           uniform     300;
    }
}


