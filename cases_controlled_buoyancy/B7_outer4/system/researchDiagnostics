// Net power [W] through all non-empty metal boundaries considered here.
metalBoundaryEnergyPower
{
    type            surfaceFieldValue;
    libs            ("libfieldFunctionObjects.so");
    region          metal;

    log             true;
    executeControl  writeTime;
    executeInterval 1;
    writeControl    writeTime;
    writeInterval   1;

    writeFields     false;
    surfaceFormat   none;
    patches         (metalTop metal_to_mold);
    operation       sum;

    fields
    (
        energyAdvectiveFlux
        heatFlux
        energyFlux
    );
}

// Sensible enthalpy inventory: integral(rho*h dV) [J].
// This is deliberately NOT labelled "total energy" because latent heat is
// handled by the phase-change model and must be analysed separately.
metalSensibleEnthalpy
{
    type            volFieldValue;
    libs            ("libfieldFunctionObjects.so");
    region          metal;

    log             true;
    executeControl  writeTime;
    executeInterval 1;
    writeControl    writeTime;
    writeInterval   1;

    writeFields     false;
    cellZone        all;
    operation       volIntegrate;
    weightField     rho;

    fields
    (
        h
    );
}

// Volume-average liquid fraction; useful alongside front tracking.
metalMeanLiquidFraction
{
    type            volFieldValue;
    libs            ("libfieldFunctionObjects.so");
    region          metal;

    log             true;
    executeControl  writeTime;
    executeInterval 1;
    writeControl    writeTime;
    writeInterval   1;

    writeFields     false;
    cellZone        all;
    operation       volAverage;

    fields
    (
        phaseChangeSource:alpha1
    );
}
