FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      epsilon;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -3 0 0 0 0];

internalField   uniform 4e-06;

boundaryField
{
    frontAndBack
    {
        type            empty;
    }
    metalTop
    {
        type            epsilonWallFunction;
        value           uniform 4e-06;
    }
    metal_to_mold
    {
        type            epsilonWallFunction;
        value           uniform 4e-06;
    }
}


