// Net power [W] through all non-empty metal boundaries considered here.
metalBoundaryEnergyPower
{
    type            surfaceFieldValue;
    libs            ("libfieldFunctionObjects.so");
    region          metal;

    log             true;
    executeControl  writeTime;
    executeInterval 1;
    writeControl    writeTime;
    writeInterval   1;

    writeFields     false;
    surfaceFormat   none;
    patches         (metalTop metal_to_mold);
    operation       sum;

    fields
    (
        energyAdvectiveFlux
        heatFlux
        energyFlux
    );
}

// Sensible enthalpy inventory: integral(rho*h dV) [J].
// This is deliberately NOT labelled "total energy" because latent heat is
// handled by the phase-change model and must be analysed separately.
metalSensibleEnthalpy
{
    type            volFieldValue;
    libs            ("libfieldFunctionObjects.so");
    region          metal;

    log             true;
    executeControl  writeTime;
    executeInterval 1;
    writeControl    writeTime;
    writeInterval   1;

    writeFields     false;
    cellZone        all;
    operation       volIntegrate;
    weightField     rho;

    fields
    (
        h
    );
}

// Volume-average liquid fraction; useful alongside front tracking.
metalMeanLiquidFraction
{
    type            volFieldValue;
    libs            ("libfieldFunctionObjects.so");
    region          metal;

    log             true;
    executeControl  writeTime;
    executeInterval 1;
    writeControl    writeTime;
    writeInterval   1;

    writeFields     false;
    cellZone        all;
    operation       volAverage;

    fields
    (
        phaseChangeSource:alpha1
    );
}

// ------------------------------------------------------------------------- //
// Thermal gradients
// ------------------------------------------------------------------------- //

temperatureGradient
{
    type            grad;
    libs            ("libfieldFunctionObjects.so");
    region          metal;

    field           T;
    result          gradT;

    executeControl  writeTime;
    writeControl    writeTime;
}

temperatureGradientMagnitude
{
    type            mag;
    libs            ("libfieldFunctionObjects.so");
    region          metal;

    field           gradT;
    result          magGradT;

    executeControl  writeTime;
    writeControl    writeTime;
}

// ------------------------------------------------------------------------- //
// Density gradients — physically important for the B-family buoyancy route.
// In the C-family rho is constant, so gradRho should be approximately zero.
// ------------------------------------------------------------------------- //

densityGradient
{
    type            grad;
    libs            ("libfieldFunctionObjects.so");
    region          metal;

    field           rho;
    result          gradRho;

    executeControl  writeTime;
    writeControl    writeTime;
}

densityGradientMagnitude
{
    type            mag;
    libs            ("libfieldFunctionObjects.so");
    region          metal;

    field           gradRho;
    result          magGradRho;

    executeControl  writeTime;
    writeControl    writeTime;
}

// ------------------------------------------------------------------------- //
// Local temporal rates.
// NOTE: OpenFOAM v14's ddt function object is evaluated during solver runtime
// and is NOT supported by foamPostProcess for retrospective reconstruction.
// ------------------------------------------------------------------------- //

temperatureTimeDerivative
{
    type            ddt;
    libs            ("libfieldFunctionObjects.so");
    region          metal;

    field           T;
    result          dTdt;

    executeControl  writeTime;
    writeControl    writeTime;
}

coolingRate
{
    type            scale;
    libs            ("libfieldFunctionObjects.so");
    region          metal;

    field           dTdt;
    scale           -1;
    result          coolingRate;

    executeControl  writeTime;
    writeControl    writeTime;
}

liquidFractionTimeDerivative
{
    type            ddt;
    libs            ("libfieldFunctionObjects.so");
    region          metal;

    field           phaseChangeSource:alpha1;
    result          dAlphaLdt;

    executeControl  writeTime;
    writeControl    writeTime;
}

solidificationRate
{
    type            scale;
    libs            ("libfieldFunctionObjects.so");
    region          metal;

    // Positive = liquid fraction decreasing = solidification.
    // Negative = liquid fraction increasing = local remelting.
    field           dAlphaLdt;
    scale           -1;
    result          solidificationRate;

    executeControl  writeTime;
    writeControl    writeTime;
}

// ------------------------------------------------------------------------- //
// Local latent-heat release/absorption rate.
//
// latentHeatRateVol = rho * L * solidificationRate
//
// Units: W/m3
// Sign convention:
//   positive -> latent-heat release during solidification
//   negative -> latent-heat absorption during remelting
// ------------------------------------------------------------------------- //

latentHeatField
{
    type            uniform;
    libs            ("libfieldFunctionObjects.so");
    region          metal;

    fieldType       volScalarField;
    field           latentHeat;
    dimensions      [0 2 -2 0 0 0 0];
    value           2.286e5;

    executeControl  writeTime;
    writeControl    writeTime;
}

latentHeatRateDensity
{
    type            multiply;
    libs            ("libfieldFunctionObjects.so");
    region          metal;

    fields
    (
        rho
        solidificationRate
        latentHeat
    );
    result          latentHeatRateVol;

    executeControl  writeTime;
    writeControl    writeTime;
}

// ------------------------------------------------------------------------- //
// Cell-wise Courant number.
// For compressible/mass-flux phi, OpenFOAM v14 divides by rho internally.
// ------------------------------------------------------------------------- //

cellCourantNumber
{
    type            CourantNo;
    libs            ("libfieldFunctionObjects.so");
    region          metal;

    phi             phi;
    rho             rho;
    result          CoCell;

    executeControl  writeTime;
    writeControl    writeTime;
}

