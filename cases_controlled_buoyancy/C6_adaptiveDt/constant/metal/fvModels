FoamFile
{
    format      ascii;
    class       dictionary;
    object      fvModels;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

phaseChangeSource
{
    type            solidificationMeltingSource;
    libs            (fvModels);

    // Explicitly target the whole mesh domain
    selectionMode   cellZone;
    cellZone        metal;

    // Thermophysical linking
    thermoMode      thermo;
    beta            1.13e-04;   // Thermal expansion coefficient [1/K]
    rhoRef          6820;       // reference solid density

    // --- Energy and phase bounds
    energy          h;
    Tsol            1423;   // Solidus temperature [K]
    Tliq            1473;   // Liquidus temperature [K] (mushy zone width = Tliq - Tsol)
    L               2.286e5;   // Latent heat of fusion [J/kg]
    alpha1e         0.8;    // Max eutectic melt fraction [0-1)

    // --- Enthalpy-Porosity tuning parameters ---
    relax           0.1;       // default value: 0.9 (water-ice example)
    Cu              1e5;      // Mushy zone Darcy constant [1/s]
    q               1e-3;     // Relaxation/division-by-zero protection parameter
}

