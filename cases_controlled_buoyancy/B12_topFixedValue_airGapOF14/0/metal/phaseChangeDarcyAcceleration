FoamFile
{
    format      ascii;
    class       volVectorField;
    location    "0/metal";
    object      phaseChangeDarcyAcceleration;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -2 0 0 0 0];

internalField   uniform (-0 -0 -0);

boundaryField
{
    metalTop
    {
        type            calculated;
        value           uniform (-0 -0 -0);
    }
    frontAndBack
    {
        type            empty;
    }
    metal_to_mold
    {
        type            calculated;
        value           uniform (-0 -0 -0);
    }
}


