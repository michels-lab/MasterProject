FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      functions;
}

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

temperatureProbe
{
    type            probes;
    libs            ("libfieldFunctionObjects.so");

    // Región donde se encuentra el probe
    region          metal;

    // Campos registrados
    fields
    (
        T
        phaseChangeSource:alpha1
    );

    // Posición del probe [m]
    probeLocations
    (
        (0.02 0.02 0.005)
    );

    // Evaluar en cada paso de tiempo
    executeControl  timeStep;
    executeInterval 1;

    // Escribir en cada paso de tiempo
    writeControl    timeStep;
    writeInterval   1;

    // Guardar resultados en postProcessing
    writeToFile     true;
}

horizontalProfiles
{
    type            sets;
    libs            ("libsampling.so");

    // Sample only the fluid metal region
    region          metal;

    // Write profiles at the case write times
    writeControl    writeTime;

    interpolationScheme cellPoint;
    setFormat       raw;

    // U is written as a vector, so the raw profile contains Ux, Uy and Uz.
    // |U| is derived exactly during analysis from the sampled components.
    fields
    (
        U
        T
        phaseChangeSource:alpha1
    );

    sets
    {
        // Horizontal profile at mid-height: y = 20 mm
        line_y20mm
        {
            type        lineUniform;
            axis        x;
            start       (0.00025 0.020 0.005);
            end         (0.03975 0.020 0.005);
            nPoints     80;
        }

        // Horizontal profile closer to the free surface: y = 30 mm
        // The metal top is y = 40 mm, so this line is 10 mm below it.
        line_y30mm
        {
            type        lineUniform;
            axis        x;
            start       (0.00025 0.030 0.005);
            end         (0.03975 0.030 0.005);
            nPoints     80;
        }
    }
}

