FoamFile
{
    format      ascii;
    class       dictionary;
    location    "constant";
    object      physicalProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

thermoType
{
    type            heRhoThermo;
    mixture         pureMixture;
    transport       const;
    thermo          hConst;
    equationOfState icoTabulated; //Boussinesq; //icoTabulated;
    specie          specie;
    energy          sensibleEnthalpy;
}

mixture
{
    specie
    {
        molWeight       56;
    }
    equationOfState
    {
        T0              1473;
        rho0            6820;
        beta            1.13e-04;

        rho
        {
            values
            (
                (293.15   7200)   // Room Temp (20°C)
                (873.15   7050)
                (1273.15  6930)   // Solid state (1000°C)
                (1423.15  6900)   // Solidus threshold (1150°C)
                (1473.15  6820)   // Liquidus threshold (1200°C)
                (1573.15  6740)
                (1773.15  6580)   // Molten liquid max (1500°C)        
            );
        }

    }
    thermodynamics
    {
        Cp              827;
        hf              0;
    }
    transport
    {
        mu              5.5e-03; // Pa.s
        Pr              0.14;
    }
}


