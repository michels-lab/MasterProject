thermoType
{
    type            heSolidThermo;
    mixture         pureMixture;
    transport       constIsoSolid;
    thermo          eConst;
    equationOfState rhoConst;
    specie          specie;
    energy          sensibleInternalEnergy;
}

mixture
{
    specie
    {
        nMoles      1;
        molWeight   56; // [kg/kmol]
    }

    transport
    {
        kappa   40;    // [W/m/K]
    }

    thermodynamics
    {
        hf      0;
        Cv      577;    // [J/kg/K]
    }

    equationOfState
    {
        rho     7686;   // [kg/m^3]
    }
}

