FoamFile
{
    format      ascii;
    class       dictionary;
    object      controlDict;
}

// ************************************************************************* //

application     foamMultiRun;

regionSolvers
{
    metal       fluid;
    mold        solid;
}

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         10;

deltaT          0.001;

writeControl    timeStep;

writeInterval   100;

purgeWrite      0;

writeFormat     ascii;

writePrecision  6;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable true;

adjustTimeStep  no;

maxCo           0.25;

maxDeltaT       0.1;


// ************************************************************************* //
