FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      functions;
}

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

temperatureProbe
{
    type            probes;
    libs            ("libfieldFunctionObjects.so");

    // Región donde se encuentra el probe
    region          metal;

    // Campos registrados
    fields
    (
        U
        T
        p_rgh
        rho
        phaseChangeSource:alpha1
    );

    // Posición del probe [m]
    probeLocations
    (
        (0.02 0.02 0.005)
    );

    // Evaluar en cada paso de tiempo
    executeControl  timeStep;
    executeInterval 1;

    // Escribir en cada paso de tiempo
    writeControl    timeStep;
    writeInterval   1;

    // Guardar resultados en postProcessing
    writeToFile     true;
}


// Registro directo solicitado para V14: valores cara por cara en metalTop
// escritos cuando el solver guarda un estado (writeTime).
topFlow
{
    type            surfaceFieldValue;
    libs            ("libfieldFunctionObjects.so");
    region          metal;

    patch           metalTop;
    surfaceFormat   raw;

    writeControl    writeTime;
    writeToFile     true;
    log             true;

    operation       none;
    writeFields     true;

    fields
    (
        U
        phi
    );
}

