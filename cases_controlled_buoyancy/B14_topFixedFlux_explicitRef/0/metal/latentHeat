FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0/metal";
    object      latentHeat;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 228600;

boundaryField
{
    metalTop
    {
        type            calculated;
        value           uniform 228600;
    }
    frontAndBack
    {
        type            empty;
    }
    metal_to_mold
    {
        type            calculated;
        value           uniform 228600;
    }
}


