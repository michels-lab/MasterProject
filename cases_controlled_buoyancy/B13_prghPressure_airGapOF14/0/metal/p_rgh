FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      p_rgh;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform 1e5;

boundaryField
{
    frontAndBack
    {
        type            empty;
    }
    metalTop
    {
        type            prghPressure;
        p               uniform 0;
        rho             rho;
        value           uniform 2667.739248;
    }
    metal_to_mold
    {
        type            fixedFluxPressure;
        value           $internalField;
    }
}


