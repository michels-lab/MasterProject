FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0/metal";
    object      coolingRate;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 -1 1 0 0 0];

internalField   uniform -0;

boundaryField
{
    metalTop
    {
        type            calculated;
        value           uniform -0;
    }
    frontAndBack
    {
        type            empty;
    }
    metal_to_mold
    {
        type            calculated;
        value           uniform -0;
    }
}


