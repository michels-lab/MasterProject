// ------------------------------------------------------------------------- //
// Local temporal rates.
// NOTE: OpenFOAM v14's ddt function object is evaluated during solver runtime
// and is NOT supported by foamPostProcess for retrospective reconstruction.
// ------------------------------------------------------------------------- //

temperatureTimeDerivative
{
    type            ddt;
    libs            ("libfieldFunctionObjects.so");
    region          metal;

    field           T;
    result          dTdt;

    executeControl  writeTime;
    writeControl    writeTime;
}

coolingRate
{
    type            scale;
    libs            ("libfieldFunctionObjects.so");
    region          metal;

    field           dTdt;
    scale           -1;
    result          coolingRate;

    executeControl  writeTime;
    writeControl    writeTime;
}

liquidFractionTimeDerivative
{
    type            ddt;
    libs            ("libfieldFunctionObjects.so");
    region          metal;

    field           phaseChangeSource:alpha1;
    result          dAlphaLdt;

    executeControl  writeTime;
    writeControl    writeTime;
}

solidificationRate
{
    type            scale;
    libs            ("libfieldFunctionObjects.so");
    region          metal;

    // Positive = liquid fraction decreasing = solidification.
    // Negative = liquid fraction increasing = local remelting.
    field           dAlphaLdt;
    scale           -1;
    result          solidificationRate;

    executeControl  writeTime;
    writeControl    writeTime;
}

// ------------------------------------------------------------------------- //
// Local latent-heat release/absorption rate.
//
// latentHeatRateVol = rho * L * solidificationRate
//
// Units: W/m3
// Sign convention:
//   positive -> latent-heat release during solidification
//   negative -> latent-heat absorption during remelting
// ------------------------------------------------------------------------- //

latentHeatField
{
    type            uniform;
    libs            ("libfieldFunctionObjects.so");
    region          metal;

    fieldType       volScalarField;
    field           latentHeat;
    dimensions      [0 2 -2 0 0 0 0];
    value           2.286e5;

    executeControl  writeTime;
    writeControl    writeTime;
}

latentHeatRateDensity
{
    type            multiply;
    libs            ("libfieldFunctionObjects.so");
    region          metal;

    fields
    (
        rho
        solidificationRate
        latentHeat
    );
    result          latentHeatRateVol;

    executeControl  writeTime;
    writeControl    writeTime;
}

