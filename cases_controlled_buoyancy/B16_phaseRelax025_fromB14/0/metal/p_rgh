FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      p_rgh;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform 1e5;

boundaryField
{
    frontAndBack
    {
        type            empty;
    }
    metalTop
    {
        type            fixedFluxPressure;
        value           $internalField;
    }
    metal_to_mold
    {
        type            fixedFluxPressure;
        value           $internalField;
    }
}


