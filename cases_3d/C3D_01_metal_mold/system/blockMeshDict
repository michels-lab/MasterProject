/* QuickCup C3D-01: primera malla de fondo, no malla física final.
 * OpenFOAM Foundation v14: las coordenadas siguientes están en MILÍMETROS.
 * units [mm] convierte automáticamente la malla generada a SI [m].
 * Los STL originales permanecen en mm para geometry.units [mm] en snappy.
 * Caja: 58 x 72 x 58 mm, 29 x 36 x 29 celdas de 2 mm.
 */
FoamFile
{
    version 2.0;
    format ascii;
    class dictionary;
    object blockMeshDict;
}
units [mm];
vertices
(
    (-3 -69 -3) // 0
    (55 -69 -3) // 1
    (55 3 -3) // 2
    (-3 3 -3) // 3
    (-3 -69 55) // 4
    (55 -69 55) // 5
    (55 3 55) // 6
    (-3 3 55) // 7
);
blocks
(
    hex (0 1 2 3 4 5 6 7) (29 36 29) simpleGrading (1 1 1)
);
edges ();
boundary
(
    outerBox
    {
        type patch;
        faces
        (
            (0 1 5 4) // yMin: normal -Y
            (3 7 6 2) // yMax: normal +Y
            (0 4 7 3) // xMin: normal -X
            (1 2 6 5) // xMax: normal +X
            (0 3 2 1) // zMin: normal -Z
            (4 5 6 7) // zMax: normal +Z
        );
    }
);
mergePatchPairs ();
