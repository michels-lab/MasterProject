/* C3D-05 STEP/Gmsh independent topology-only OpenFOAM 14 case. NO CFD. */
FoamFile
{
    version 2.0;
    format ascii;
    class dictionary;
    object controlDict;
}
application checkMesh;
startFrom startTime;
startTime 0;
stopAt endTime;
endTime 0;
deltaT 0.001;
writeControl timeStep;
writeInterval 1;
writeFormat ascii;
writePrecision 12;
runTimeModifiable no;
