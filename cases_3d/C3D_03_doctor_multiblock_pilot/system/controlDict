/* C3D-03 topology-only multiblock pilot. NO PHYSICS / NO CFD. */
FoamFile
{
    version 2.0;
    format ascii;
    class dictionary;
    object controlDict;
}
application checkMesh;
startFrom startTime;
startTime 0;
stopAt endTime;
endTime 0;
deltaT 0.001;
writeControl timeStep;
writeInterval 1;
writeFormat ascii;
writePrecision 10;
runTimeModifiable no;
