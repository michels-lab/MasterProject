#!/usr/bin/env bash
# C3D-04 V4 Caso A: isolated basal defect correction, Foundation 14. NO CFD.
# Always create a fresh, independent output folder. Never delete old evidence.
set -Eeuo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO="$(cd "$ROOT/../../../.." && pwd)"
SOURCE="$REPO/cases_3d/C3D_02_metal_sand_clean/constant/geometry"
OUT="${C3D04_V4_OUT:?Set a fresh absolute output folder via C3D04_V4_OUT}"
MODE="${C3D04_V4_MODE:?Set inner_y or profile}"
VALUE="${C3D04_V4_VALUE:?Set the geometric experiment value}"
SOURCE_DICT="${C3D04_V4_BASE_DICT:-$HOME/OpenFOAM/C3D04_V3_BASAL_SWEEP_01/T06/system/blockMeshDict}"
STAGE="PREFLIGHT"
if [[ "$OUT" != /* ]]; then echo "ERROR: C3D04_V4_OUT must be absolute" >&2; exit 2; fi
if [[ -e "$OUT" || -L "$OUT" ]]; then
    echo "PRESERVED: destination exists; refusing overwrite: $OUT" >&2
    exit 2
fi
[[ -r /opt/openfoam14/etc/bashrc ]] || { echo "Missing Foundation 14 bashrc" >&2; exit 2; }
[[ -r "$SOURCE/metal_v2.stl" && -r "$SOURCE/mold_v2.stl" ]] || { echo "Missing approved CAD reference STL(s)" >&2; exit 2; }
[[ "$(sha256sum "$SOURCE/metal_v2.stl" | awk '{print $1}')" == "f8c0fb90f9b5650261d39f1faa2430b3fc7fce462c0d44e460afb5a37b4ddccf" ]] || { echo "metal_v2 SHA mismatch" >&2; exit 2; }
[[ "$(sha256sum "$SOURCE/mold_v2.stl" | awk '{print $1}')" == "ac52991eb254c1bcc65eaf546a25f663343e006e89aeff3ac26aa8e9a1d95a32" ]] || { echo "mold_v2 SHA mismatch" >&2; exit 2; }
set +u
source /opt/openfoam14/etc/bashrc
set -u
for utility in blockMesh checkMesh splitMeshRegions; do command -v "$utility" >/dev/null || { echo "Missing native utility $utility" >&2; exit 2; }; done
source "$REPO/cases_3d/C3D_02_metal_sand_clean/scripts/native_checkmesh_report.sh"
# The source is the already-executed T06 3D-A mesh. Verify its exact
# parametric lineage against versioned V2, never trust a mislabeled folder.
[[ -r "$SOURCE_DICT" ]] || { echo "Missing preserved V3/T06 blockMeshDict: $SOURCE_DICT" >&2; exit 2; }
python3 "$REPO/cases_3d/C3D_04_rounded_multiblock_pilot/candidates/C3D04_V3_BASAL_SWEEP/tests/test_v3_diff.py" \
    "$REPO/cases_3d/C3D_04_rounded_multiblock_pilot/candidates/C3D04_V2_BASAL_QUALITY/system/blockMeshDict" \
    "$SOURCE_DICT" --delta 0.45 --grading 2.65 ||
    { echo "T06 provenance verification failed" >&2; exit 2; }
# The new case must not overwrite any previous candidate or source file.
mkdir -p "$OUT/system"
python3 "$ROOT/scripts/build_v4_dictionary.py" "$SOURCE_DICT" \
    "$OUT/system/blockMeshDict" --mode "$MODE" --value "$VALUE" \
    > "$OUT/log.generateDictionary" 2>&1 ||
    { cat "$OUT/log.generateDictionary" >&2; exit 2; }
python3 "$ROOT/tests/test_v4_diff.py" "$SOURCE_DICT" \
    "$OUT/system/blockMeshDict" --mode "$MODE" --value "$VALUE" \
    > "$OUT/log.staticDiff" 2>&1 ||
    { cat "$OUT/log.staticDiff" >&2; exit 2; }
python3 "$REPO/cases_3d/C3D_04_rounded_multiblock_pilot/scripts/audit_blockmesh_topology.py" \
    "$OUT/system/blockMeshDict" > "$OUT/log.staticTopology" 2>&1 ||
    { cat "$OUT/log.staticTopology" >&2; exit 2; }
cp "$REPO/cases_3d/C3D_04_rounded_multiblock_pilot/system/controlDict" "$OUT/system/controlDict"
cat > "$OUT/NATIVE_BUILD_STATUS.txt" <<EOF
PREFLIGHT_COMPLETE / NO_CFD
Input: $ROOT
Output: $OUT
STL reference: checked by SHA256; not used as meshing input
EOF
fail() {
    local message="$1"
    printf 'REJECTED / stage=%s / %s / NO_CFD\n' "$STAGE" "$message" | tee "$OUT/NATIVE_BUILD_STATUS.txt" >&2
    # One command must leave a complete read-only postmortem, including spatial
    # defects and contact area even when the quality gate rejects the mesh.
    local diagnosis="$OUT/C3D04_V4_DIAGNOSTIC.txt"
    python3 "$REPO/cases_3d/C3D_04_rounded_multiblock_pilot/scripts/diagnose_existing_defects.py" "$OUT" > "$diagnosis" 2>&1 || true
    echo "=== C3D04 V4 AUTOMATIC DIAGNOSTIC ===" >&2
    tail -n 100 "$diagnosis" >&2 || true
    echo "Inspect preserved logs and diagnostic at $OUT" >&2
    exit 5
}
run_native() {
    local label="$1"; shift
    STAGE="$label"
    echo "RUNNING / stage=$STAGE / NO_CFD" > "$OUT/NATIVE_BUILD_STATUS.txt"
    if ! "$@" > "$OUT/log.$label" 2>&1; then
        tail -n 40 "$OUT/log.$label" >&2 || true
        fail "OpenFOAM native utility failed; log.$label"
    fi
}
run_native blockMesh blockMesh -case "$OUT"
[[ -s "$OUT/constant/polyMesh/cellZones" ]] || fail "No parent cellZones"
for region in metal mold; do
    grep -Eq "(^|[^[:alnum:]_])$region([^[:alnum:]_]|$)" "$OUT/constant/polyMesh/cellZones" ||
        fail "Expected named zone missing: $region"
done
run_native checkMesh.parent checkMesh -case "$OUT" -allGeometry -allTopology -writeSurfaces -writeSets
run_native splitMeshRegions splitMeshRegions -case "$OUT" -cellZones 'metal mold' -noFields
[[ ! -e "$OUT/constant/exterior/polyMesh" ]] || fail "Unexpected exterior material region"
for region in metal mold; do
    [[ -s "$OUT/constant/$region/polyMesh/boundary" ]] || fail "Missing $region regional boundary"
done
# Collect both regional checkMesh results even if one region fails.
STAGE=CHECK_REGION_QUALITY
mesh_ok=1
printf 'region\tcells\tvolume_m3\tCAD_m3\tmesh_ok\n' > "$OUT/PILOT_MESH_REPORT.tsv"
for region in metal mold; do
    log="$OUT/log.checkMesh.$region"
    if ! checkMesh -case "$OUT" -region "$region" -allGeometry -allTopology -writeSurfaces -writeSets > "$log" 2>&1; then
        mesh_ok=0
    fi
    nCells="$(awk '/^[[:space:]]*cells:/{print $2;exit}' "$log")"
    vol="$(foam_checkmesh_total_volume "$log")"
    if [[ "$region" == metal ]]; then target="4.7987697e-5"; expected=8960; else target="1.02843333e-4"; expected=12352; fi
    verdict=NO
    if grep -Eq '(^|[[:space:]])Mesh OK' "$log" && ! grep -Eq 'Failed[[:space:]]+[1-9][0-9]*[[:space:]]+mesh checks' "$log" &&
        grep -Eq 'Number of regions:[[:space:]]*1([^0-9]|$)' "$log" &&
        [[ "$nCells" == "$expected" && -n "$vol" ]] &&
        awk -v v="$vol" -v target="$target" 'BEGIN{d=v/target-1;exit !(v>0 && d>=-0.02 && d<=0.02)}'; then
        verdict=YES
    else
        mesh_ok=0
    fi
    printf '%s\t%s\t%s\t%s\t%s\n' "$region" "${nCells:-NA}" "${vol:-NA}" "$target" "$verdict" >> "$OUT/PILOT_MESH_REPORT.tsv"
done
# A real named, reciprocal mappedWall contact is required, not merely a split log string.
patch_value() {
    local file="$1" patch="$2" key="$3"
    awk -v p="$patch" -v k="$key" '
        $1==p { found=1; next }
        found && $1=="{" { active=1; next }
        found && active && $1=="}" { exit }
        found && active && $1==k { gsub(/;/,"",$2); print $2; exit }
    ' "$file"
}
STAGE=CHECK_INTERFACE
metal_boundary="$OUT/constant/metal/polyMesh/boundary"
mold_boundary="$OUT/constant/mold/polyMesh/boundary"
for spec in "metal metal_to_mold mold mold_to_metal" "mold mold_to_metal metal metal_to_mold"; do
    read -r origin patch neighbour reverse <<< "$spec"
    if [[ "$origin" == metal ]]; then file="$metal_boundary"; else file="$mold_boundary"; fi
    [[ "$(patch_value "$file" "$patch" type)" == mappedWall ]] || fail "$patch type is not mappedWall"
    [[ "$(patch_value "$file" "$patch" neighbourRegion)" == "$neighbour" ]] || fail "$patch has wrong neighbourRegion"
    [[ "$(patch_value "$file" "$patch" neighbourPatch)" == "$reverse" ]] || fail "$patch has wrong neighbourPatch"
done
# Rounded blockMesh pilot must not invent unclassified outer surfaces.
parent_unknown="$(patch_value "$OUT/constant/polyMesh/boundary" unexpectedFaces nFaces)"
[[ -z "$parent_unknown" || "$parent_unknown" == 0 ]] ||
    fail "Unexpected unclassified boundary faces in parent mesh: $parent_unknown"
metal_faces="$(patch_value "$metal_boundary" metal_to_mold nFaces)"
mold_faces="$(patch_value "$mold_boundary" mold_to_metal nFaces)"
[[ "$metal_faces" == "$mold_faces" && "$metal_faces" == 2496 ]] ||
    fail "Unexpected metal/mold mappedWall contact nFaces: metal=$metal_faces mold=$mold_faces expected=2496"
printf 'mappedWall faces (each side): %s\n' "$metal_faces" > "$OUT/PILOT_INTERFACE_REPORT.txt"
bash "$REPO/cases_3d/C3D_02_metal_sand_clean/scripts/native_interface_audit.sh" "$OUT" >> "$OUT/PILOT_INTERFACE_REPORT.txt"
if (( mesh_ok != 1 )); then
    STAGE=CHECK_REGION_QUALITY
    cat "$OUT/PILOT_MESH_REPORT.tsv"
    fail "At least one native checkMesh, CAD volume or expected region cell count rejected"
fi
STAGE=CHECK_PARENT_QUALITY
if ! grep -Eq '(^|[[:space:]])Mesh OK' "$OUT/log.checkMesh.parent" ||
    grep -Eq 'Failed[[:space:]]+[1-9][0-9]*[[:space:]]+mesh checks' "$OUT/log.checkMesh.parent"; then
    fail "Parent mesh checkMesh not accepted"
fi
STAGE=CHECK_CONTACT_AREA
# Standard-library Python ONLY measures areas of the mesh produced by native OpenFOAM.
# It neither builds nor modifies the mesh and does NOT execute CFD.
if ! python3 "$REPO/cases_3d/C3D_04_rounded_multiblock_pilot/scripts/measure_interface_area.py" "$OUT" \
    --out "$OUT/CONTACT_AREA_REPORT.json" > "$OUT/log.contactArea" 2>&1; then
    tail -n 45 "$OUT/log.contactArea" >&2 || true
    fail "Contact area audit rejected or OpenFOAM polyMesh not ASCII"
fi
printf 'MESH_TOPOLOGY_AND_CONTACT_AREA_PRELIMINARILY_ACCEPTED / NO_CFD\nCAD surface distance and 3D physical BC still unverified.\n' > "$OUT/NATIVE_BUILD_STATUS.txt"
cat "$OUT/PILOT_MESH_REPORT.tsv"
cat "$OUT/PILOT_INTERFACE_REPORT.txt"
cat "$OUT/log.contactArea"
echo "TOPOLOGY AND CONTACT AREA PILOT COMPLETE; no thermophysical dictionaries, 0/ fields or solver executed."
echo "CAD surface fit and 3D boundary conditions remain UNVALIDATED."
echo "Result: $OUT"
