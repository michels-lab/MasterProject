additional3DProfiles
{
    type            sets;
    libs            ("libsampling.so");

    // Sample only the fluid metal region
    region          metal;

    // Write profiles at the case write times
    writeControl    writeTime;

    interpolationScheme cellPoint;
    setFormat       raw;

    // U is written as a vector, so the raw profile contains Ux, Uy and Uz.
    // |U| is derived exactly during analysis from the sampled components.
    fields
    (
        U
        T
        p_rgh
        rho
        phaseChangeSource:alpha1

        // Flow topology
        vorticity
        flowType
        magSqrDevGradU

        // Thermal-gradient and cooling diagnostics
        gradT
        magGradT
        dTdt
        coolingRate

        // Density-gradient / buoyancy diagnostics
        gradRho
        magGradRho

        // Phase-change-rate diagnostics
        dAlphaLdt
        solidificationRate
        latentHeatRateVol

        // Numerical field
        CoCell
    );

    sets
    {
        height10_angle45
        {
            type lineUniform;
            axis x;
            start (0.0119346410716 -0.03 0.0119346410716);
            end (0.0398653589284 -0.03 0.0398653589284);
            nPoints 80;
        }
        height10_angle90
        {
            type lineUniform;
            axis z;
            start (0.0259 -0.03 0.00615);
            end (0.0259 -0.03 0.04565);
            nPoints 80;
        }
        height10_angle135
        {
            type lineUniform;
