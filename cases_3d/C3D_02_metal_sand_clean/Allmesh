#!/usr/bin/env bash
# C3D-02 native OpenFOAM Foundation 14 mesh pipeline (no Python).
# Stop before CFD: never run foamMultiRun until 3D BCs and physical interfaces are verified.
set -Eeuo pipefail

ROOT="$(cd "$(dirname "$0")" && pwd)"
CASE="$HOME/OpenFOAM/C3D02_NATIVE_OF14_01"
# Parse reports from native OpenFOAM logs, never infer volumes from the first '='.
source "$ROOT/scripts/native_checkmesh_report.sh"

# Recalculate the existing comparison WITHOUT remeshing or modifying past TSV.
if (( $# == 1 )) && [[ "$1" == "--compare" ]]; then
    baseline="$HOME/OpenFOAM/C3D02_NATIVE_OF14_01"
    candidate="$HOME/OpenFOAM/C3D02_NATIVE_SMOOTH_01"
    for region in metal mold; do
        [[ -s "$baseline/log.checkMesh.$region" ]] || {
            echo "Missing baseline native log: $region" >&2; exit 2;
        }
        [[ -s "$candidate/log.checkMesh.$region" ]] || {
            echo "Missing candidate native log: $region" >&2; exit 2;
        }
    done
    corrected="$candidate/CANDIDATE_COMPARISON_CORRECTED.tsv"
    foam_write_mesh_comparison "$baseline" "$candidate" "$corrected"
    echo "=== Corrected comparison from existing OpenFOAM logs ==="
    cat "$corrected"
    echo "Saved: $corrected"
    echo "Existing meshes, original TSV, physical dictionaries and CFD unchanged."
    exit 0
fi

# Preserve a rejected c3d - better mesh while completing its physical inputs
# from the exact C14 baseline. Does not change quality gates or run CFD.
if (( $# == 1 )) && [[ "$1" == "--stage-c14-better" ]]; then
    bash "$ROOT/scripts/stage_c14_materials.sh" "$HOME/OpenFOAM/c3d-better"
    echo "Material inputs copied and verified; the rejected mesh remains rejected."
    exit 0
fi

# Existing-mesh diagnosis: no remeshing, no Python, no material edits, no CFD.
if (( $# > 0 )) && [[ "$1" == "--diagnose" ]]; then
    [[ -d "$CASE" ]] || { echo "No existing C3D-02 case: $CASE" >&2; exit 2; }
    [[ -r /opt/openfoam14/etc/bashrc ]] || { echo "Missing OpenFOAM 14" >&2; exit 2; }
    set +u
    source /opt/openfoam14/etc/bashrc
    set -u
    report="$CASE/NATIVE_DIAGNOSTIC.txt"
    {
        printf 'C3D-02 / native checkMesh diagnostics / existing mesh only\n'
        printf 'Location: %s\n' "$CASE"
        printf 'Original build status: '
        cat "$CASE/NATIVE_BUILD_STATUS.txt" 2>/dev/null || echo unavailable
        printf 'No blockMesh, snappyHexMesh, splitMeshRegions, or CFD is rerun.\n'
    } > "$report"
    for region in metal mold; do
        log="$CASE/log.checkMesh.$region"
        boundary="$CASE/constant/$region/polyMesh/boundary"
        if [[ ! -f "$boundary" ]]; then
            printf '\n%s: NO REGIONAL MESH\n' "$region" | tee -a "$report"
            continue
        fi
        if [[ ! -s "$log" ]]; then
            echo "Running native checkMesh on previously unexamined region: $region"
            if checkMesh -case "$CASE" -region "$region" \
                -allGeometry -allTopology -writeSurfaces -writeSets > "$log" 2>&1; then
                :
            else
                echo "checkMesh $region returned nonzero; inspect its log." | tee -a "$report"
            fi
        fi
        {
            printf '\n=== %s / %s ===\n' "$region" "$log"
            grep -Ei 'cells:|Total volume|Number of regions|Mesh OK|Failed [0-9]+ mesh checks|concave|determinant|face.tets|non.orthogonal|skew|illegal|negative|FOAM FATAL|ERROR' "$log" |
                tail -n 65 || true
            printf '\n--- End of native log ---\n'
            tail -n 12 "$log"
        } | tee -a "$report"
    done
    # Produce isolated native OpenFOAM VTK evidence for each material.
    # Each region has its own physical copy, so checkMesh cannot overwrite
    # an identically named VTK produced for the other material.
    quality="$CASE/native_quality"
    mkdir -p "$quality"
    for region in metal mold; do
        mesh="$CASE/constant/$region/polyMesh"
        dest="$quality/$region"
        if [[ ! -d "$mesh" ]]; then
            continue
        fi
        if [[ -e "$dest" ]]; then
            printf '\n%s: diagnostic copy already exists; preserving it: %s\n' \
                "$region" "$dest" | tee -a "$report"
        else
            mkdir -p "$dest/constant" "$dest/system"
            cp -a "$mesh" "$dest/constant/polyMesh"
            cp "$CASE/system/controlDict" "$dest/system/controlDict"
            printf '\n%s: native checkMesh on isolated COPY %s\n' "$region" "$dest" | tee -a "$report"
            if checkMesh -case "$dest" -allGeometry -allTopology \
                    -writeSurfaces -writeSets > "$dest/log.checkMesh" 2>&1; then
                :
            else
                echo "OpenFOAM checkMesh returned nonzero in copy of $region." | tee -a "$report"
            fi
        fi
        {
            printf '\n--- %s: isolated native VTK defects ---\n' "$region"
            find "$dest" -type f \( -iname '*concave*.vtk' -o \
                -iname '*underdetermined*.vtk' -o \
                -iname '*lowQuality*.vtk' \) -print | sort
            printf '\n--- %s: isolated checkMesh status ---\n' "$region"
            if [[ -s "$dest/log.checkMesh" ]]; then
                grep -Ei 'cells:|Total volume|Mesh OK|Failed [0-9]+ mesh checks|concave|determinant|face.tets|FOAM FATAL' \
                    "$dest/log.checkMesh" | tail -n 22 || true
            fi
        } | tee -a "$report"
    done
    {
        printf '\nInterpretation: VTK files represent defect surfaces / vertices, not cell-centre positions.\n'
        printf 'Visualize the region-specific VTKs in ParaView on top of the matching mesh.\n'
        printf 'No meshing, no CFD and no physical-property changes were performed.\n'
    } | tee -a "$report"
    printf '\nDiagnostic summary saved: %s\n' "$report"
    echo "Meshes preserved; this is not acceptance or CFD."
    exit 0
fi
# A separate, controlled native snappyHexMesh sensitivity test:
# nSmoothPatch changes 3 -> 6 ONLY in the new local copy.
VARIANT=baseline
if (( $# == 1 )) && [[ "$1" == "--candidate-smooth" ]]; then
    VARIANT=smooth
    CASE="$HOME/OpenFOAM/C3D02_NATIVE_SMOOTH_01"
elif (( $# == 1 )) && [[ "$1" == "--better" ]]; then
    VARIANT=better
    CASE="$HOME/OpenFOAM/c3d-better"
elif (( $# == 1 )) && [[ "$1" == "--stl-v2" ]]; then
    VARIANT=stl_v2
    CASE="$HOME/OpenFOAM/c3d-better-stl-v2"
elif (( $# > 0 )); then
    echo "Usage: bash Allmesh [--diagnose|--candidate-smooth|--better|--stl-v2|--compare|--stage-c14-better]" >&2
    exit 2
fi
if [[ -e "$CASE" || -L "$CASE" ]]; then
    echo "ERROR: delivery exists, preserving evidence: $CASE" >&2
    exit 2
fi
mkdir -p "$CASE/system" "$CASE/constant/geometry"
STAGE=PREFLIGHT
fail() {
    echo "BLOCKED / $STAGE / $*" > "$CASE/NATIVE_BUILD_STATUS.txt"
    echo "ERROR [$STAGE]: $*" >&2
    echo "Logs: $CASE" >&2
    exit 5
}
echo "RUNNING / PREFLIGHT" > "$CASE/NATIVE_BUILD_STATUS.txt"
[[ -r /opt/openfoam14/etc/bashrc ]] || fail "OpenFOAM Foundation 14 not installed"
set +u
source /opt/openfoam14/etc/bashrc
set -u
for app in blockMesh snappyHexMesh splitMeshRegions checkMesh foamDictionary; do
    command -v "$app" >/dev/null 2>&1 || fail "Missing OpenFOAM utility: $app"
done
bash "$ROOT/scripts/validate_sources.sh" > "$CASE/log.sources" 2>&1 ||
    fail "STL or C14 inputs failed source validation"
cp "$ROOT/system/blockMeshDict" "$ROOT/system/snappyHexMeshDict" \
   "$ROOT/system/controlDict" "$CASE/system/"
cp "$ROOT/constant/geometry/metal.stl" \
   "$ROOT/constant/geometry/mold_repaired.stl" "$CASE/constant/geometry/"

# v2 SolidWorks: verify SHA-256 and native OpenFOAM surfaceCheck first.
# Only the NEW case copy is modified; historical STL and meshes untouched.
if [[ "$VARIANT" == stl_v2 ]]; then
    STAGE=VERIFY_STL_V2
    bash "$ROOT/scripts/check_stl_v2.sh" > "$CASE/log.verify_stl_v2" 2>&1 ||
        fail "Missing/invalid v2 STLs: see $CASE/log.verify_stl_v2"
    cp "$ROOT/constant/geometry/metal_v2.stl" "$CASE/constant/geometry/metal.stl"
    cp "$ROOT/constant/geometry/mold_v2.stl" "$CASE/constant/geometry/mold_repaired.stl"
    {
        echo "c3d - better / SolidWorks v2 candidate"
        echo "metal_v2.stl -> metal.stl (new case copy only)"
        echo "mold_v2.stl -> mold_repaired.stl (new case copy only)"
        echo "STL units [mm]; physical properties C14 unchanged"
        sha256sum "$CASE/constant/geometry/metal.stl" "$CASE/constant/geometry/mold_repaired.stl"
        echo "Only source candidate, not certified mesh or CFD"
    } > "$CASE/STL_V2_SOURCE_MAP.txt"
fi

if [[ "$VARIANT" == smooth ]]; then
    STAGE=CONTROLLED_SNAP_VARIANT
    foamDictionary "$CASE/system/snappyHexMeshDict" \
        -entry snapControls/nSmoothPatch -set 6 > "$CASE/log.snap_variant" 2>&1 ||
        fail "Native foamDictionary could not set nSmoothPatch to 6"
    selected="$(foamDictionary "$CASE/system/snappyHexMeshDict" -entry snapControls/nSmoothPatch)" ||
        fail "Cannot verify modified snapControls/nSmoothPatch"
    [[ "$selected" =~ (^|[^0-9])6([^0-9]|$) ]] ||
        fail "Unexpected nSmoothPatch after native edit: $selected"
    {
        echo "HYPOTHESIS TEST ONLY: nSmoothPatch 3 -> 6"
        echo "Modified with foamDictionary Foundation 14 in candidate output only"
        echo "STL, surface refinement L2, zone definitions and all C14 files unchanged"
        echo "NO claim that this change improves mesh quality without checkMesh"
    } > "$CASE/CANDIDATE_CHANGE.txt"
fi

# Validate the zone declarations with OpenFOAM's own dictionary reader.
for material in metal mold; do
    zone="$(foamDictionary "$CASE/system/snappyHexMeshDict" \
        -entry "castellatedMeshControls/refinementSurfaces/$material/cellZone")" ||
        fail "Cannot read cellZone for $material"
    [[ "$zone" == *"$material"* ]] || fail "Wrong cellZone for $material: $zone"
done

run_native() {
    local name="$1"
    shift
    STAGE="$name"
    echo "RUNNING / $STAGE" > "$CASE/NATIVE_BUILD_STATUS.txt"
    "$@" > "$CASE/log.$name" 2>&1 || fail "OpenFOAM command failed: $name"
}
run_native blockMesh blockMesh -case "$CASE"
run_native snappyHexMesh snappyHexMesh -case "$CASE" -overwrite
[[ -f "$CASE/constant/polyMesh/cellZones" ]] ||
    fail "No cellZones in the parent mesh"
for material in metal mold; do
    grep -Eq "(^|[^[:alnum:]_])$material([^[:alnum:]_]|$)" \
        "$CASE/constant/polyMesh/cellZones" ||
        fail "The $material region was not labelled by snappyHexMesh"
done

run_native splitMeshRegions splitMeshRegions -case "$CASE" \
    -cellZones 'metal mold' -defaultRegion exterior -noFields
for material in metal mold; do
    [[ -f "$CASE/constant/$material/polyMesh/boundary" ]] ||
        fail "Missing generated physical mesh for $material"
done
STAGE=STAGE_C14_MATERIALS
bash "$ROOT/scripts/stage_c14_materials.sh" "$CASE" > "$CASE/log.stage_c14" 2>&1 ||
    fail "C14 material integrity failed; read log.stage_c14"

# Inspect native boundary files without modifying them.
patch_value() {
    local file="$1" patch="$2" key="$3"
    awk -v p="$patch" -v k="$key" '
        $1 == p { found=1; next }
        found && $1 == "{" { active=1; next }
        found && active && $1 == "}" { exit }
        found && active && $1 == k { gsub(/;/,"",$2); print $2; exit }
    ' "$file"
}
metal_boundary="$CASE/constant/metal/polyMesh/boundary"
mold_boundary="$CASE/constant/mold/polyMesh/boundary"
[[ "$(patch_value "$metal_boundary" metal_to_mold type)" == mappedWall ]] ||
    fail "metal_to_mold is not mappedWall"
[[ "$(patch_value "$mold_boundary" mold_to_metal type)" == mappedWall ]] ||
    fail "mold_to_metal is not mappedWall"
[[ "$(patch_value "$metal_boundary" metal_to_mold neighbourRegion)" == mold ]] ||
    fail "Contact from metal does not target mold"
[[ "$(patch_value "$mold_boundary" mold_to_metal neighbourRegion)" == metal ]] ||
    fail "Contact from mold does not target metal"
[[ "$(patch_value "$metal_boundary" metal_to_mold neighbourPatch)" == mold_to_metal ]] ||
    fail "metal contact is not reciprocal"
[[ "$(patch_value "$mold_boundary" mold_to_metal neighbourPatch)" == metal_to_mold ]] ||
    fail "mold contact is not reciprocal"
metal_faces="$(patch_value "$metal_boundary" metal_to_mold nFaces)"
mold_faces="$(patch_value "$mold_boundary" mold_to_metal nFaces)"
[[ "$metal_faces" =~ ^[1-9][0-9]*$ && "$metal_faces" == "$mold_faces" ]] ||
    fail "Mismatch in contact faces: metal=$metal_faces, mold=$mold_faces"

# Native checkMesh does not certify success by return code alone.
# Candidate mode checks BOTH regions to retain complete comparative evidence.
candidate_rejected=0
for region in metal mold; do
    run_native "checkMesh.$region" checkMesh -case "$CASE" -region "$region" \
        -allGeometry -allTopology -writeSurfaces -writeSets
    log="$CASE/log.checkMesh.$region"
    if [[ "$VARIANT" == smooth || "$VARIANT" == better || "$VARIANT" == stl_v2 ]]; then
        if grep -Eq 'Failed[[:space:]]+[1-9][0-9]*[[:space:]]+mesh checks' "$log" ||
           ! grep -Eq '(^|[[:space:]])Mesh OK' "$log" ||
           ! grep -Eq 'Number of regions:[[:space:]]*1([^0-9]|$)' "$log"; then
            candidate_rejected=1
        fi
        vol_candidate="$(foam_checkmesh_total_volume "$log")"
        if [[ "$region" == metal ]]; then cad_candidate=0.0000479874896432; else cad_candidate=0.00010284309608; fi
        if [[ -z "$vol_candidate" ]] ||
           ! awk -v v="$vol_candidate" -v ref="$cad_candidate" 'BEGIN{d=v/ref-1;if(v<=0||d>0.02||d< -0.02)exit 1}'; then
            candidate_rejected=1
        fi
        continue
    fi
    if grep -Eq 'Failed[[:space:]]+[1-9][0-9]*[[:space:]]+mesh checks' "$log"; then
        echo "Native checkMesh findings for $region:" >&2
        grep -Ei 'Failed [0-9]+ mesh checks|concave|determinant|face.tets|non.orthogonal|skew|illegal|negative' "$log" |
            tail -n 25 >&2 || true
        fail "$region: native checkMesh reported failed geometry/topology checks"
    fi
    grep -Eq '(^|[[:space:]])Mesh OK' "$log" ||
        fail "$region: checkMesh did not report Mesh OK; inspect log.checkMesh.$region"
    grep -Eq 'Number of regions:[[:space:]]*1([^0-9]|$)' "$log" ||
        fail "$region: more than one connected region or no region count"
    volume="$(foam_checkmesh_total_volume "$log")"
    [[ -n "$volume" ]] || fail "$region: no region volume in checkMesh output"
    if [[ "$region" == metal ]]; then cad=0.0000479874896432; else cad=0.00010284309608; fi
    awk -v v="$volume" -v ref="$cad" '
        BEGIN { d=v/ref-1; if(v<=0 || d>0.02 || d< -0.02) exit 1 }
    ' || fail "$region: CAD volume deviation exceeds 2% ($volume m3)"
done

if [[ "$VARIANT" == smooth || "$VARIANT" == better || "$VARIANT" == stl_v2 ]]; then
    STAGE=CONTROLLED_COMPARISON
    baseline="$HOME/OpenFOAM/C3D02_NATIVE_OF14_01"
    if [[ "$VARIANT" == stl_v2 ]]; then
        comparison="$CASE/STL_V2_COMPARISON.tsv"
    elif [[ "$VARIANT" == better ]]; then
        comparison="$CASE/C3D_BETTER_COMPARISON.tsv"
        printf '%s\n' "c3d - better: native OpenFOAM repeat of the L2 source baseline" \
            "nSmoothPatch=3; no change to STLs, properties, or C14" \
            "Run ID: c3d-better; do not mistake the name for mesh acceptance" \
            > "$CASE/C3D_BETTER_RUN.txt"
    else
        comparison="$CASE/CANDIDATE_COMPARISON.tsv"
    fi
    foam_write_mesh_comparison "$baseline" "$CASE" "$comparison"
    echo "=== OpenFOAM native C3D-02: $VARIANT ==="
    cat "$comparison"
    echo "Results and native checkMesh VTK are preserved at $CASE"
    if (( candidate_rejected )); then
        echo "REJECTED / $VARIANT mesh quality or CAD gate failed" > "$CASE/NATIVE_BUILD_STATUS.txt"
        echo "At least one 3D region failed mesh acceptance; no solver executed."
        exit 5
    fi
    echo "MESH_PRELIMINARY_ACCEPTED / $VARIANT / NO_CFD" > "$CASE/NATIVE_BUILD_STATUS.txt"
    echo "Both native mesh gates passed; 3D boundary conditions are still unvalidated."
    exit 0
fi

# Material integrity was checked BEFORE quality validation, including for
# rejected runs. Never silently overwrite an existing physical dictionary.
echo "MESH_PRELIMINARY_ACCEPTED / NO_CFD" > "$CASE/NATIVE_BUILD_STATUS.txt"
echo "Native checkMesh and two physical interfaces were evaluated." \
     >> "$CASE/NATIVE_BUILD_STATUS.txt"
echo "3D field BCs and solver-read validation are still pending." \
     >> "$CASE/NATIVE_BUILD_STATUS.txt"
echo "DONE: OpenFOAM native geometry/mesh at $CASE"
echo "NO foamMultiRun: mesh quality alone is not CFD validation."
