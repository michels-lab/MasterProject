/* C3D-02: single CLOSED material solid, NOT combined domain.
 * This is a SOURCE TEMPLATE. The runner copies it to each independent
 * subcase and selects exactly one STL/one point for material volume.
 * Foundation v14 STL coordinates in millimetres; convert once to SI.
 */
FoamFile
{
    version 2.0;
    format ascii;
    class dictionary;
    object snappyHexMeshDict;
}
castellatedMesh true;
snap true;
addLayers false;
geometry
{
    material
    {
        type triSurfaceMesh;
        file "MATERIAL_STL_PLACEHOLDER";
        units [mm];
    }
}
castellatedMeshControls
{
    maxLocalCells 400000;
    maxGlobalCells 3000000;
    minRefinementCells 0;
    nCellsBetweenLevels 2;
    features ();
    refinementSurfaces
    {
        material
        {
            level (2 2);
            patchInfo { type wall; }
        }
    }
    resolveFeatureAngle 30;
    refinementRegions {};
    insidePoint MATERIAL_POINT_PLACEHOLDER;
}
snapControls
{
    nSmoothPatch 3;
    tolerance 1.0;
    nSolveIter 50;
    nRelaxIter 5;
    nFeatureSnapIter 0;
    implicitFeatureSnap false;
    explicitFeatureSnap false;
    multiRegionFeatureSnap false;
}
addLayersControls
{
    relativeSizes true;
    layers {};
    expansionRatio 1.0;
    finalLayerThickness 0.3;
    minThickness 0.1;
    nGrow 0;
    featureAngle 90;
    nRelaxIter 5;
    nSmoothSurfaceNormals 1;
    nSmoothNormals 3;
    nSmoothThickness 10;
    maxFaceThicknessRatio 0.5;
    maxThicknessToMedialRatio 0.3;
    minMedialAxisAngle 90;
    nBufferCellsNoExtrude 0;
    nLayerIter 0;
}
meshQualityControls
{
    #includeEtc "caseDicts/mesh/generation/meshQualityDict.cfg"
}
mergeTolerance 1e-6;
