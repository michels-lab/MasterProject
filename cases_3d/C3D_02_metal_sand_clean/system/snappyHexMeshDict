/* C3D-02: candidate TWO-MATERIAL surface mesh, OpenFOAM Foundation 14.
 * STLs are in mm; units [mm] converts EACH STL to metres.
 * Native Foundation 14 source: metal/mold cellZones are both declared here.
 * An auxiliary exterior is retained for splitting, never included in CFD.
 * This dictionary is UNRUN; no claim of an accepted mesh or CHT.
 */
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      snappyHexMeshDict;
}
castellatedMesh true;
snap            true;
addLayers       false;

geometry
{
    mold
    {
        type    triSurfaceMesh;
        file    "mold_repaired.stl";
        units   [mm];
    }
    metal
    {
        type    triSurfaceMesh;
        file    "metal.stl";
        units   [mm];
    }
}

castellatedMeshControls
{
    maxLocalCells       400000;
    maxGlobalCells      3000000;
    minRefinementCells  0;
    nCellsBetweenLevels 2;

    features ();

    refinementSurfaces
    {
        mold
        {
            level       (2 2);
            faceZone    moldInterface;
            cellZone    mold;
            mode        inside;
            faceType    internal;
            patchInfo { type wall; }
        }

        metal
        {
            level       (2 2);
            faceZone    metalInterface;
            cellZone    metal;
            mode        inside;
            faceType    internal;
            patchInfo { type wall; }
        }
    }
    resolveFeatureAngle 30;

    refinementRegions {};

    // Seed both physical materials and auxiliary EXTERIOR for zone separation.
    // Exterior is NOT a CHT region; all three are checked after meshing.
    // OpenFOAM Foundation uses insidePoints (not OpenCFD locationsInMesh).
    insidePoints
    (
        (0.0259 -0.0200 0.0259)
        (0.0043 -0.0207 0.0259)
        (-0.002 -0.068 -0.002)
    );
    allowFreeStandingZoneFaces false;
}

snapControls
{
    nSmoothPatch        3;
    tolerance           1.0;
    nSolveIter          50;
    nRelaxIter          5;
    nFeatureSnapIter    0;
    implicitFeatureSnap false;
    explicitFeatureSnap false;
    multiRegionFeatureSnap false;
}

addLayersControls
{
    relativeSizes true;
    layers {};
    expansionRatio 1.0;
    finalLayerThickness 0.3;
    minThickness 0.1;
    nGrow 0;
    featureAngle 90;
    nRelaxIter 5;
    nSmoothSurfaceNormals 1;
    nSmoothNormals 3;
    nSmoothThickness 10;
    maxFaceThicknessRatio 0.5;
    maxThicknessToMedialRatio 0.3;
    minMedialAxisAngle 90;
    nBufferCellsNoExtrude 0;
    nLayerIter 0;
}

meshQualityControls
{
    #includeEtc "caseDicts/mesh/generation/meshQualityDict.cfg"
}
mergeTolerance 1e-6;
