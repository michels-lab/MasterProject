FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

regionSolvers
{
    fluid           compressibleVoF;
    mold            solid;
}

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         2e-07;

deltaT          1e-07;

writeControl    timeStep;

writeInterval   1;

purgeWrite      0;

writeFormat     ascii;

writePrecision  12;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable false;

adjustTimeStep  yes;

maxCo           0.1;

maxAlphaCo      0.1;

maxDeltaT       1e-07;

// ************************************************************************* //


// FS-C06_NATIVE_VOF_PHASE_MONITORS
// These are native OpenFOAM function objects; they do not infer mass or shrinkage.
// The phase-change fvModel must register alpha.metal.solid before writing.
functions
{
    FS_C06_metalVoFVolume
    {
        type          volFieldValue;
        libs          ("libfieldFunctionObjects.so");
        region        fluid;
        log           true;
        writeControl  timeStep;
        writeInterval 1;
        writeFields   false;
        cellZone      all;
        operation     volIntegrate;
        fields        (alpha.metal);
    }

    FS_C06_solidMetalVolume
    {
        type          volFieldValue;
        libs          ("libfieldFunctionObjects.so");
        region        fluid;
        log           true;
        writeControl  timeStep;
        writeInterval 1;
        writeFields   false;
        cellZone      all;
        operation     volIntegrate;
        fields        (alpha.metal.solid);
    }

    // Foundation14 phase-1 and phase-2 transported MASS fluxes:
    // alphaRhoPhi.metal, alphaRhoPhi.air, and their mixture sum rhoPhi.
    // Sum is outward-normal signed on boundary patches, in kg/s.
    // Atmosphere flux alone does NOT prove closed metal mass balance.
    FS_C06_mixtureMass
    {
        type          volFieldValue;
        libs          ("libfieldFunctionObjects.so");
        region        fluid;
        log           true;
        writeControl  timeStep;
        writeInterval 1;
        writeFields   false;
        cellZone      all;
        operation     volIntegrate;
        fields        (rho);
    }

    FS_C06_atmosphereMassFlux
    {
        type          surfaceFieldValue;
        libs          ("libfieldFunctionObjects.so");
        region        fluid;
        log           true;
        writeControl  timeStep;
        writeInterval 1;
        writeFields   false;
        patches       (atmosphereTop atmosphereSides atmosphereLowerSides);
        operation     sum;
        fields        (alphaRhoPhi.metal alphaRhoPhi.air rhoPhi);
    }

    FS_C06_atmosphereTopMassFlux
    {
        type          surfaceFieldValue;
        libs          ("libfieldFunctionObjects.so");
        region        fluid;
        log           true;
        writeControl  timeStep;
        writeInterval 1;
        writeFields   false;
        patch         atmosphereTop;
        operation     sum;
        fields        (alphaRhoPhi.metal alphaRhoPhi.air rhoPhi);
    }

    FS_C06_atmosphereSidesMassFlux
    {
        type          surfaceFieldValue;
        libs          ("libfieldFunctionObjects.so");
        region        fluid;
        log           true;
        writeControl  timeStep;
        writeInterval 1;
        writeFields   false;
        patch         atmosphereSides;
        operation     sum;
        fields        (alphaRhoPhi.metal alphaRhoPhi.air rhoPhi);
    }

    FS_C06_atmosphereLowerSidesMassFlux
    {
        type          surfaceFieldValue;
        libs          ("libfieldFunctionObjects.so");
        region        fluid;
        log           true;
        writeControl  timeStep;
        writeInterval 1;
        writeFields   false;
        patch         atmosphereLowerSides;
        operation     sum;
        fields        (alphaRhoPhi.metal alphaRhoPhi.air rhoPhi);
    }

    FS_C06_fluidToMoldMassFlux
    {
        type          surfaceFieldValue;
        libs          ("libfieldFunctionObjects.so");
        region        fluid;
        log           true;
        writeControl  timeStep;
        writeInterval 1;
        writeFields   false;
        patch         fluid_to_mold;
        operation     sum;
        fields        (alphaRhoPhi.metal alphaRhoPhi.air rhoPhi);
    }
}
