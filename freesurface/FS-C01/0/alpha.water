FoamFile
{
    version 2.0;
    format ascii;
    class volScalarField;
    location "0";
    object alpha.water;
}
dimensions [];
internalField
{
    type zonal;
    defaultValue 0;
    zones
    {
        waterColumn
        {
            type box;
            box (0 0 -1) (0.04 0.04 1);
            value 1;
        }
    }
}
boundaryField
{
    #includeEtc "caseDicts/setConstraintTypes"
    wall { type zeroGradient; }
    atmosphere
    {
        type inletOutlet;
        inletValue uniform 0;
    }
}
