// FS-C07_THERMAL_WRITE_INTERVAL: independent native function objects
// write at parent controlDict output instants (0.05 s), not every CFD time step.
// execute() of wallHeatFlux stays every step; write() is on selected write times.
// This avoids one time directory per timestep from writeLocalObjects::write().
// Native Foundation14 writeTime supported, but performance not yet WSL verified.
// FS-C06_FOUNDATION14_FUNCTION_OBJECTS
// Native function objects are read from system/functions (Foundation 12+).
// Not system/controlDict/functions. All measured diagnostics are solver-owned.
// Two time steps are model/monitor smoke only, NOT shrinkage.
    FS_C06_metalVoFVolume
    {
        type          volFieldValue;
        libs          ("libfieldFunctionObjects.so");
        region        fluid;
        log           true;
        writeControl  writeTime;
        writeInterval 1;
        writeFields   false;
        cellZone      all;
        operation     volIntegrate;
        fields        (alpha.metal);
    }

    FS_C06_solidMetalVolume
    {
        type          volFieldValue;
        libs          ("libfieldFunctionObjects.so");
        region        fluid;
        log           true;
        writeControl  writeTime;
        writeInterval 1;
        writeFields   false;
        cellZone      all;
        operation     volIntegrate;
        fields        (alpha.metal.solid);
    }

    // Foundation14 phase-1 and phase-2 transported MASS fluxes:
    // alphaRhoPhi.metal, alphaRhoPhi.air, and their mixture sum rhoPhi.
    // Sum is outward-normal signed on boundary patches, in kg/s.
    // Atmosphere flux alone does NOT prove closed metal mass balance.
    FS_C06_mixtureMass
    {
        type          volFieldValue;
        libs          ("libfieldFunctionObjects.so");
        region        fluid;
        log           true;
        writeControl  writeTime;
        writeInterval 1;
        writeFields   false;
        cellZone      all;
        operation     volIntegrate;
        fields        (rho);
    }

    FS_C06_atmosphereMassFlux
    {
        type          surfaceFieldValue;
        libs          ("libfieldFunctionObjects.so");
        region        fluid;
        log           true;
        writeControl  writeTime;
        writeInterval 1;
        writeFields   false;
        patches       (atmosphereTop atmosphereSides atmosphereLowerSides);
        operation     sum;
        fields        (alphaRhoPhi.metal alphaRhoPhi.air rhoPhi);
    }

    FS_C06_atmosphereTopMassFlux
    {
        type          surfaceFieldValue;
        libs          ("libfieldFunctionObjects.so");
        region        fluid;
        log           true;
        writeControl  writeTime;
        writeInterval 1;
        writeFields   false;
        patch         atmosphereTop;
        operation     sum;
        fields        (alphaRhoPhi.metal alphaRhoPhi.air rhoPhi);
    }

    FS_C06_atmosphereSidesMassFlux
    {
        type          surfaceFieldValue;
        libs          ("libfieldFunctionObjects.so");
        region        fluid;
        log           true;
        writeControl  writeTime;
        writeInterval 1;
        writeFields   false;
        patch         atmosphereSides;
        operation     sum;
        fields        (alphaRhoPhi.metal alphaRhoPhi.air rhoPhi);
    }

    FS_C06_atmosphereLowerSidesMassFlux
    {
        type          surfaceFieldValue;
        libs          ("libfieldFunctionObjects.so");
        region        fluid;
        log           true;
        writeControl  writeTime;
        writeInterval 1;
        writeFields   false;
        patch         atmosphereLowerSides;
        operation     sum;
        fields        (alphaRhoPhi.metal alphaRhoPhi.air rhoPhi);
    }

    FS_C06_fluidToMoldMassFlux
    {
        type          surfaceFieldValue;
        libs          ("libfieldFunctionObjects.so");
        region        fluid;
        log           true;
        writeControl  writeTime;
        writeInterval 1;
        writeFields   false;
        patch         fluid_to_mold;
        operation     sum;
        fields        (alphaRhoPhi.metal alphaRhoPhi.air rhoPhi);
    }

    // Foundation14 native conjugate wall heat-flux probes, same grammar
    // as the prior FS-C05 accepted instrumented probe. Signed Q in W.
    FS_C06_wallHeatFluxFluid
    {
        type          wallHeatFlux;
        libs          ("libfieldFunctionObjects.so");
        region        fluid;
        patches       (fluid_to_mold);
        executeControl timeStep;
        executeInterval 1;
        writeControl  writeTime;
        writeInterval 1;
        log           true;
    }

    FS_C06_wallHeatFluxMold
    {
        type          wallHeatFlux;
        libs          ("libfieldFunctionObjects.so");
        region        mold;
        patches       (mold_to_fluid);
        executeControl timeStep;
        executeInterval 1;
        writeControl  writeTime;
        writeInterval 1;
        log           true;
    }
