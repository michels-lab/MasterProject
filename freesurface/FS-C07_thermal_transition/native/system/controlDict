FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// FS-C07 experimental screen controls: 1 s horizon, adaptive dt <=1e-4 s,
// maxCo=maxAlphaCo=0.1, fields written every 0.05 s.
// Values are NUMERICAL controls, NOT calibrated thermal properties.
// When temperature crosses the nominal C14 liquidus, phase fractions are
// evaluated on native saved T.metal, alpha.metal, alpha.metal.solid.
// NO phase-density or conservative shrinkage coupling is active.

regionSolvers
{
    fluid           compressibleVoF;
    mold            solid;
}

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         1;

deltaT          1e-07;

writeControl    adjustableRunTime;

writeInterval   0.05;

purgeWrite      0;

writeFormat     ascii;

writePrecision  12;

writeCompression off;

timeFormat      general;

timePrecision   10;

runTimeModifiable false;

adjustTimeStep  yes;

maxCo           0.1;

maxAlphaCo      0.1;

maxDeltaT       1e-04;

// ************************************************************************* //


