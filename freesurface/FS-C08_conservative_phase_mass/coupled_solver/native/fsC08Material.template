/* FS-C08 material dictionary template — NON-EXECUTABLE until calibrated.
 * File to install in a STAGED CASE: constant/fluid/fsC08Material
 * T in K, rho in kg/m3; latentHeat in J/kg; cvSolid in J/(kg K) at CONSTANT VOLUME.
 * Phase fraction curve is SOLID MASS FRACTION (not volume fraction).
 * Use separate source records for each CE/S composition. NO defaults.
 *
 * Do NOT copy FS-C07's numerical (1423,1473) model as experimental data.
 * These placeholders are mandatory; the stager must refuse the template.
 */
FoamFile
{
    version 2.0;
    format ascii;
    class dictionary;
    location "constant/fluid";
    object fsC08Material;
}

materialId <ALLOY_COMPOSITION_ID_REQUIRED>;
propertySource <JMATPRO_OR_EXPERIMENTAL_SOURCE_ID_REQUIRED>;

// Valid interval for every iron-containing CFD cell.
// The computational metal/air trace cutoff below is a numerical parameter,
// NOT an allowed excuse to neglect metal mass conservation.
Tmin_K <SUPPORTED_MIN_TEMPERATURE_K>;
Tmax_K <SUPPORTED_MAX_TEMPERATURE_K>;
metalPresenceThreshold <MATERIAL_TRACE_VOF_THRESHOLD>;

// Darcy drag for mushy-region momentum, calibrated or separately sourced.
// Cu units [1/s]; q is a positive dimensionless regularizer (0<q<=1).
// Both entries are mandatory and intentionally have NO numeric defaults.
mushyDarcyCu [0 0 -1 0 0 0 0] <CALIBRATED_MUSHY_CU_PER_SECOND>;
mushyDarcyQ <DOCUMENTED_DARCY_REGULARIZER>;

// Select an EXPLICIT physical closure. No arbitrary per-deltaT factor:
// - equilibrium: evaluate f_s,mass(T) at each CFD time step
// - kineticRelaxation: use physical tau(T) in seconds, from measured data
phaseChangeClosure <equilibrium_OR_kineticRelaxation>;

// Required ONLY with kineticRelaxation, do NOT add for equilibrium:
// tauPhaseChangeT table
// (
//     (<T_1_K> <TAU_1_S_FROM_EXPERIMENT>)
//     (<T_2_K> <TAU_2_S_FROM_EXPERIMENT>)
// );

rhoLiquidT table
(
    (<T_1_K> <RHO_L_1_KG_PER_M3>)
    (<T_2_K> <RHO_L_2_KG_PER_M3>)
);
rhoSolidT table
(
    (<T_1_K> <RHO_S_1_KG_PER_M3>)
    (<T_2_K> <RHO_S_2_KG_PER_M3>)
);
solidMassFractionT table
(
    (<T_1_K> <FS_MASS_FRACTION_1>)
    (<T_2_K> <FS_MASS_FRACTION_2>)
);

// The Cv parameter is NOT interchangeable with experimental Cp.
// Derive consistent Cv(T) or justify Cp≈Cv before claiming energy closure.
latentHeat [0 2 -2 0 0 0 0] <LATENT_J_PER_KG>;
cvSolid [0 2 -2 -1 0 0 0] <SOLID_CP_J_PER_KG_K>;
