FoamFile
{
    format      ascii;
    class       dictionary;
    location    "constant";
    object      physicalProperties;
}

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

thermoType
{
    type            heRhoThermo;
    mixture         pureMixture;
    transport       const;
    thermo          hConst;
    equationOfState rhoConst;
    specie          specie;
    energy          sensibleEnthalpy;
}

mixture
{
    specie
    {
        molWeight   56;
    }

    equationOfState
    {
        rho         6930;
    }

    thermodynamics
    {
        Cp          827;
        hf          0;
    }

    transport
    {
        mu          5.5e-03;
        Pr          0.14;
    }
}

