FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 1 0 0 0];

internalField   uniform 1500;

boundaryField
{
    frontAndBack
    {
        type            empty;
    }

    metalTop
    {
        type            externalWallHeatFluxTemperature;
        h               uniform 50;
        Ta              constant 300;
        value           $internalField;
        emissivity      0.3;
    }

    metal_to_mold
    {
        type            coupledTemperature;
        thicknessLayers   (2e-4); // list of optional wall layer thicknesses (air gap)
        kappaLayers       (1e-1); // list of optinal wall layer thermal conductivities [W/(m.K)]
        value           uniform     1500;
    }
}


