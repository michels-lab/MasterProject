/*--------------------------------*- C++ -*----------------------------------*\
  QuickCup spatial top-flow post-processing — OpenFOAM Foundation v14
\*---------------------------------------------------------------------------*/

FoamFile
{
    format      ascii;
    class       dictionary;
    location    "analysis_tools";
    object      topSurfaceFlowPostProcessing;
}

// Writes face-by-face values on metalTop.  The raw surface writer preserves
// the patch geometry plus the selected field values for later visualization.
topPatchFaceFields
{
    type            surfaceFieldValue;
    libs            ("libfieldFunctionObjects.so");
    region          metal;

    log             true;
    writeControl    timeStep;
    writeInterval   1;

    patch           metalTop;
    operation       none;

    writeFields     true;
    surfaceFormat   raw;

    fields
    (
        phi
        U
        T
        p_rgh
        rho
    );
}

// Existing net-flux metric, reconstructed retrospectively from the stored phi.
topPhiNet
{
    type            surfaceFieldValue;
    libs            ("libfieldFunctionObjects.so");
    region          metal;

    log             true;
    writeControl    timeStep;
    writeInterval   1;

    patch           metalTop;
    operation       sum;
    writeFields     false;
    surfaceFormat   none;

    fields
    (
        phi
    );
}

// Sum of absolute face contributions.  This detects simultaneous local inflow
// and outflow that may cancel in the net patch sum.
topPhiAbsolute
{
    type            surfaceFieldValue;
    libs            ("libfieldFunctionObjects.so");
    region          metal;

    log             true;
    writeControl    timeStep;
    writeInterval   1;

    patch           metalTop;
    operation       sumMag;
    writeFields     false;
    surfaceFormat   none;

    fields
    (
        phi
    );
}

