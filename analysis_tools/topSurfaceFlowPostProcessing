// Internal flow immediately below the top boundary.  The metal mesh uses
// dy = 0.5 mm, so y=39.75 mm passes through the top row of cell centres.
nearTopInternalLine
{
    type            sets;
    libs            ("libsampling.so");
    region          metal;

    writeControl    timeStep;
    writeInterval   1;

    interpolationScheme cellPoint;
    setFormat       raw;

    fields
    (
        U
        T
        p_rgh
        rho
        phaseChangeSource:alpha1
    );

    sets
    {
        line_y39p75mm
        {
            type        lineUniform;
            axis        x;
            start       (0.00025 0.03975 0.005);
            end         (0.03975 0.03975 0.005);
            nPoints     80;
        }
    }
}

